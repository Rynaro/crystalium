{
  "mcpServers": {
    "atlas-aci": {
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "-v",
        "${PWD}:/repo:ro",
        "-v",
        "${PWD}/.atlas/memex:/memex",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "ghcr.io/rynaro/atlas-aci@sha256:386677f06b0ce23cb4883f6c0f91d8eac22328cd7d9451ae241e2f183207ad96",
        "serve",
        "--repo",
        "/repo",
        "--memex-root",
        "/memex"
      ],
      "command": "docker"
    },
    "junction": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "junction",
      "type": "stdio"
    },
    "crystalium": {
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "run",
        "--rm",
        "-i",
        "crystalium",
        "python",
        "-m",
        "crystalium",
        "serve"
      ],
      "command": "docker",
      "type": "stdio"
    }
  }
}
