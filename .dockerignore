# Git metadata
.git/
.github/

# Eval results (generated; not needed in image)
evals/results/

# Python artifacts
__pycache__/
*.pyc
.pytest_cache/
.coverage
.mypy_cache/

# Documentation (large; not needed in runtime image)
# Keep: SPEC.md, PERSONA.md (install-target references), and README.md
# (pyproject.toml [project.readme] points to it; hatchling reads it at build).
*.md
!SPEC.md
!PERSONA.md
!README.md
!AGENTS.md

# Install target (consumer-side; not part of the image)
.eidolons/

# Dev tool configs
.idea/
.vscode/
.editorconfig

# Host wiring docs (not needed in image)
hosts/

# Atlas/spectra/forge planning artefacts
.atlas/
.spectra/
.forge/

# Runtime data directory
.crystalium/
